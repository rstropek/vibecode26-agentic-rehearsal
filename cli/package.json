  "private": true,
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.0",
    "@todo-cat/contract": "0.1.0",
    "better-auth": "1.7.7",
    "commander": "15.0.0",
    "zod": "^4.6.5"
  },
